{
  "name": "faithful-repertoire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:scale": "node scripts/scale-smoke.mjs",
    "build:site": "node scripts/build-site.mjs",
    "code:count": "node scripts/code-stats.mjs",
    "catalog:analyze": "node scripts/build-catalog-analysis.mjs",
    "test:hosted": "npm run build:site && node scripts/pwa-smoke.mjs && node scripts/hosted-smoke.mjs",
    "test:pwa": "npm run build:site && node scripts/pwa-smoke.mjs",
    "deploy:mcp": "NODE_USE_ENV_PROXY=1 node scripts/deploy-mcp.mjs",
    "check:mcp": "DENO_DIR=/tmp/faithful-deno-cache npx --yes --cache /tmp/faithful-npm-cache deno@2.9.6 check --config supabase/functions/faithful-mcp/deno.json supabase/functions/faithful-mcp/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "playwright": "1.64.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "jose": "6.2.12",
    "zod": "4.3.6"
  }
}
