{
  "name": "faithful-repertoire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test test/*.test.js",
    "test:browser": "node scripts/browser-smoke.mjs",
    "test:scale": "node scripts/scale-smoke.mjs",
    "build:site": "node scripts/build-site.mjs",
    "test:hosted": "npm run build:site && node scripts/hosted-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "1.64.0"
  }
}
